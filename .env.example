# =============================================================================
# WHITE-LABEL: Para usar este sistema em outra empresa, altere apenas:
#   1. NEXT_PUBLIC_COMPANY_* (nome e identidade visual)
#   2. SIENGE_API_URL / SIENGE_BULK_API_URL  (substitua SLUG pelo slug da empresa)
#   3. SIENGE_USERNAME / SIENGE_PASSWORD     (credenciais Sienge da empresa)
#   4. ADMIN_USERNAME / ADMIN_PASSWORD       (acesso ao sistema)
#   5. DATABASE_URL                          (banco PostgreSQL desta instância)
#   6. NEXTAUTH_SECRET                       (gere um novo por instância)
# =============================================================================

# === IDENTIDADE DA EMPRESA ===
NEXT_PUBLIC_COMPANY_NAME=Nome da Construtora
NEXT_PUBLIC_COMPANY_SUBTITLE=Sistema de Gestao
NEXT_PUBLIC_COMPANY_EMAIL_DOMAIN=empresa.com.br

# === SIENGE API ===
# Substitua SLUG pelo identificador único da empresa no Sienge
# Exemplo: https://api.sienge.com.br/silvapacker/public/api/v1
SIENGE_API_URL=https://api.sienge.com.br/SLUG/public/api/v1
SIENGE_BULK_API_URL=https://api.sienge.com.br/SLUG/public/api/bulk-data/v1
SIENGE_USERNAME=
SIENGE_PASSWORD=

# === AUTENTICAÇÃO DO SISTEMA ===
# Gere um secret único por instância: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# === LOGIN COM GOOGLE (OAuth) ===
# Crie em: https://console.cloud.google.com/apis/credentials
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === BANCO DE DADOS (PostgreSQL) ===
# Cache permanente de dados estáticos: Empresas, Centros de Custo,
# Fornecedores, Plano Financeiro, Status de Entrega de Pedidos.
# Execute o arquivo schema.sql para criar as tabelas na primeira configuração.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
